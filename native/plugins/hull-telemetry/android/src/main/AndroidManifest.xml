<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- RF_BLE: passive scan only. neverForLocation keeps the scan from being
         used to derive physical location. BLUETOOTH_CONNECT is deliberately
         NOT declared: this module never connects, pairs, bonds or resolves
         advertised device names, and the CI gate fails the build if the
         connect permission reappears anywhere in the packaged manifest. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- RF_WIFI: opt-in only. FINE_LOCATION is requested at the RF_WIFI tap,
         never at launch, and is not used by any other group. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
</manifest>
